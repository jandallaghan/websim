{
  "name": "@websim/core",
  "version": "0.1.0",
  "description": "Stateful website simulations for browser automation and agent evaluations.",
  "type": "module",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "websim": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./playwright": "./dist/playwright.js",
    "./capture": "./dist/capture/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "dev": "tsx src/cli.ts dev",
    "capture:demo": "tsx src/cli.ts capture https://www.demoblaze.com/ --output examples/demoblaze/captures/store",
    "prepack": "npm run build",
    "demo:store": "tsx src/cli.ts dev examples/demoblaze"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "playwright": "^1.63.0",
    "saxes": "^6.0.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
